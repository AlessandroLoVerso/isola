<UserControl x:Class="Isola.Modules.Music.SpotifyPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Isola.Font.Text}"
             Foreground="{DynamicResource Isola.Brush.Foreground}"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <!-- Segment chip (same look as the Appunti filters) -->
        <Style x:Key="Sp.Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="GroupName" Value="spotify-segment" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Isola.Brush.Surface}" CornerRadius="12" Padding="10,0" Height="24">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Foreground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Background}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button -->
        <Style x:Key="Sp.Icon" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource Isola.Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Whole-row button -->
        <Style x:Key="Sp.Row" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="6,2,4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scroll bar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Width="4" CornerRadius="2" Background="#38FFFFFF" HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="Sp.ListTemplate" TargetType="ItemsControl">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>

        <Style x:Key="Sp.Status" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Sp.Input" TargetType="TextBox">
            <Setter Property="Margin" Value="25,0,22,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Isola.Brush.Accent}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back · segments · current track -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource Sp.Icon}" Content="&#xE72B;" ToolTip="Torna al brano" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="SegPlaylist" Style="{StaticResource Sp.Chip}" Content="Playlist" IsChecked="True" />
                <RadioButton x:Name="SegQueue" Style="{StaticResource Sp.Chip}" Content="Coda" />
                <RadioButton x:Name="SegSearch" Style="{StaticResource Sp.Chip}" Content="Cerca" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding TrackTitle}" FontSize="11.5" Margin="10,0,2,0"
                       Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TrackTitle}" />
        </Grid>

        <!-- Playlist: filter + list; click = add the current track -->
        <Grid Grid.Row="1" Visibility="{Binding IsPlaylist, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Height="26" Margin="0,0,0,4">
                <Border x:Name="FilterBorder" CornerRadius="13" Background="{DynamicResource Isola.Brush.Surface}" BorderThickness="1" BorderBrush="Transparent" />
                <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11" Margin="10,0,0,0"
                           Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="FilterHint" Text="Filtra le playlist" FontSize="12" Margin="28,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}" IsHitTestVisible="False" />
                <TextBox x:Name="FilterBox" Style="{StaticResource Sp.Input}" />
                <Button x:Name="FilterClear" Style="{StaticResource Sp.Icon}" Content="&#xE711;" FontSize="9" HorizontalAlignment="Right"
                        Margin="0,0,1,0" Visibility="Collapsed" ToolTip="Cancella" />
            </Grid>
            <ItemsControl x:Name="PlaylistList" Grid.Row="1" ItemsSource="{Binding Playlists}" Template="{StaticResource Sp.ListTemplate}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Sp.Row}" Height="28" Margin="0,0,4,0" Click="Playlist_Click"
                                ToolTip="Aggiungi il brano a questa playlist" ToolTipService.InitialShowDelay="900">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="12"
                                           Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,1" />
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Isola.Brush.Muted}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Style="{StaticResource Sp.Status}" Text="{Binding PlaylistStatus}"
                       Visibility="{Binding HasPlaylistStatus, Converter={StaticResource Vis}}" />
        </Grid>

        <!-- Queue: next 5, read-only (the API can't jump to a queued track) -->
        <Grid Grid.Row="1" Visibility="{Binding IsQueue, Converter={StaticResource Vis}}">
            <ItemsControl ItemsSource="{Binding Queue}" Focusable="False" Margin="2,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="26" ToolTip="{Binding Line}" ToolTipService.InitialShowDelay="900">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" FontSize="11" Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="250" />
                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Isola.Brush.Muted}" Margin="0,0,4,0">
                                <Run Text=" – " /><Run Text="{Binding Artist, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Sp.Status}" Text="{Binding QueueStatus}"
                       Visibility="{Binding HasQueueStatus, Converter={StaticResource Vis}}" />
        </Grid>

        <!-- Search: box + results; row = play, + = add to queue -->
        <Grid Grid.Row="1" Visibility="{Binding IsSearch, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Height="26" Margin="0,0,0,4">
                <Border x:Name="SearchBorder" CornerRadius="13" Background="{DynamicResource Isola.Brush.Surface}" BorderThickness="1" BorderBrush="Transparent" />
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11" Margin="10,0,0,0"
                           Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Cerca un brano su Spotify" FontSize="12" Margin="28,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Style="{StaticResource Sp.Input}" />
                <Button x:Name="SearchClear" Style="{StaticResource Sp.Icon}" Content="&#xE711;" FontSize="9" HorizontalAlignment="Right"
                        Margin="0,0,1,0" Visibility="Collapsed" ToolTip="Cancella ricerca" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Results}" Template="{StaticResource Sp.ListTemplate}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Sp.Row}" Height="36" Margin="0,0,4,0" Click="Result_Click"
                                ToolTip="{Binding DataContext.PlayTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTipService.InitialShowDelay="900">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="24" Height="24" HorizontalAlignment="Left">
                                    <Border CornerRadius="5" Background="{DynamicResource Isola.Brush.Surface}">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="10"
                                                   Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="5" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource Isola.Brush.Muted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Sp.Icon}" Content="&#xE768;" Click="Play_Click"
                                            IsEnabled="{Binding DataContext.CanPlay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.PlayTip, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Style="{StaticResource Sp.Icon}" Content="&#xE710;" Click="Enqueue_Click"
                                            IsEnabled="{Binding DataContext.CanEnqueue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="{Binding DataContext.EnqueueTip, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Style="{StaticResource Sp.Status}" Text="{Binding SearchStatus}"
                       Visibility="{Binding HasSearchStatus, Converter={StaticResource Vis}}" />
        </Grid>
    </Grid>
</UserControl>
