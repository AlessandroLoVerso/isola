<UserControl x:Class="Isola.Modules.Music.MusicCard" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Isola.Font.Text}"
             Foreground="{DynamicResource Isola.Brush.Foreground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <Style x:Key="Music.IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="{DynamicResource Isola.Font.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Heart and "…" (Spotify): smaller and quieter than the transport buttons -->
        <Style x:Key="Music.SmallButton" TargetType="Button" BasedOn="{StaticResource Music.IconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Music.HeartButton" TargetType="Button" BasedOn="{StaticResource Music.SmallButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Spotify.IsLiked}" Value="True">
                    <Setter Property="Foreground" Value="{Binding AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Music.PlayButton" TargetType="Button" BasedOn="{StaticResource Music.IconButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Background}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bd" Fill="{Binding AccentBrush}" />
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.28" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Apri Spotify": pill in Spotify green, black text (Spotify's own button look) -->
        <Style x:Key="Music.SpotifyButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0,20,0" />
            <Setter Property="Foreground" Value="#FF000000" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="#FF1DB954" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1ED760" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF169C46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Recenti" chip -->
        <Style x:Key="Music.RecentChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MaxWidth" Value="104" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Isola.Brush.Surface}" CornerRadius="11" Padding="10,0" Height="22">
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Player -->
        <Grid x:Name="PlayerHost">
        <Grid Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cover with a soft glow in the cover's colour -->
            <Grid Width="116" Height="116" VerticalAlignment="Top">
                <Border CornerRadius="14" Background="{DynamicResource Isola.Brush.Surface}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="Glow" BlurRadius="26" ShadowDepth="0" Opacity="0.45" Color="{Binding Accent}" />
                    </Border.Effect>
                    <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="36"
                               Foreground="{DynamicResource Isola.Brush.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="14" Background="{Binding CoverBrush}" />
            </Grid>

            <!-- Text and controls -->
            <Grid Grid.Column="1" Margin="16,0,0,0" Height="116" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,1,0,0"
                           FontFamily="{DynamicResource Isola.Font.Display}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Grid.Row="1" Text="{Binding Artist}" FontSize="13" Margin="0,1,0,0"
                           Foreground="{DynamicResource Isola.Brush.Muted}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,1,0,0"
                            Visibility="{Binding HasLyrics, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding LyricCurrent}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{Binding AccentBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LyricNext}" FontSize="11.5" Margin="0,1,0,0" Opacity="0.55"
                               Foreground="{DynamicResource Isola.Brush.Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource Music.IconButton}" Content="&#xE892;"
                            IsEnabled="{Binding CanPrev}" ToolTip="Precedente" />
                    <Button x:Name="PlayButton" Style="{StaticResource Music.PlayButton}" Content="{Binding PlayGlyph}"
                            IsEnabled="{Binding CanPlayPause}" ToolTip="{Binding PlayTip}" Margin="14,0" />
                    <Button x:Name="NextButton" Style="{StaticResource Music.IconButton}" Content="&#xE893;"
                            IsEnabled="{Binding CanNext}" ToolTip="Successiva" />
                </StackPanel>

                <!-- Spotify extras: only while Spotify plays and an account is connected -->
                <Button x:Name="HeartButton" Grid.Row="3" Style="{StaticResource Music.HeartButton}" HorizontalAlignment="Left"
                        Content="{Binding Spotify.HeartGlyph}" ToolTip="{Binding Spotify.HeartTip}" IsEnabled="{Binding Spotify.CanLike}"
                        Visibility="{Binding Spotify.IsActive, Converter={StaticResource Vis}}" />
                <Button x:Name="MoreButton" Grid.Row="3" Style="{StaticResource Music.SmallButton}" HorizontalAlignment="Right"
                        Content="&#xE712;" ToolTip="Playlist, coda e ricerca"
                        Visibility="{Binding Spotify.IsActive, Converter={StaticResource Vis}}" />
            </Grid>

            <!-- Progress -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Height="18"
                  Visibility="{Binding HasTimeline, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Elapsed}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}" />
                <Grid x:Name="SeekArea" Grid.Column="1" Background="Transparent" Cursor="Hand">
                    <Border x:Name="Track" Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center" />
                    <Border x:Name="Fill" Height="4" CornerRadius="2" Background="{Binding AccentBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                    <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="White" HorizontalAlignment="Left"
                             VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource Isola.Brush.Muted}" />
            </Grid>

            <!-- Live streams have no timeline -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Height="18" Orientation="Horizontal"
                        Visibility="{Binding IsLive, Converter={StaticResource Vis}}">
                <Ellipse Width="7" Height="7" Fill="#FF453A" VerticalAlignment="Center" />
                <TextBlock Text="In diretta" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}" />
            </StackPanel>
        </Grid>
        </Grid>

        <!-- Spotify panel (created on first use) -->
        <Border x:Name="PanelHost" Visibility="Collapsed" />

        <!-- Inline Spotify feedback ("Aggiunta a …", errors) -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"
                CornerRadius="12" Height="24" Padding="12,0" MaxWidth="360" Background="{DynamicResource Isola.Brush.Foreground}"
                IsHitTestVisible="False" Visibility="{Binding Spotify.HasMessage, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Spotify.Message}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Isola.Brush.Background}" />
        </Border>

        <!-- Nothing playing -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding NoSession, Converter={StaticResource Vis}}">
            <Border CornerRadius="14" Background="{DynamicResource Isola.Brush.Surface}" HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="56" />
                        <Setter Property="Height" Value="56" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSpotifyButton}" Value="True">
                                <Setter Property="Width" Value="44" />
                                <Setter Property="Height" Value="44" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="&#xE8D6;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="22"
                           Foreground="{DynamicResource Isola.Brush.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Niente in riproduzione" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                       FontFamily="{DynamicResource Isola.Font.Display}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptySubtitle}" FontSize="12" Margin="0,3,0,0" MaxWidth="400" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center"
                       Visibility="{Binding ShowEmptySubtitle, Converter={StaticResource Vis}}" />

            <!-- Spotify is on this PC: open it (and start the music) from here -->
            <StackPanel Visibility="{Binding ShowSpotifyButton, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                <Button x:Name="SpotifyButton" Style="{StaticResource Music.SpotifyButton}" IsEnabled="{Binding CanLaunchSpotify}"
                        HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF5B0;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SpotifyButtonText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="RecentsList" ItemsSource="{Binding Spotify.Recents}" Margin="0,10,0,0" HorizontalAlignment="Center"
                              Focusable="False" Visibility="{Binding Spotify.ShowRecents, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Music.RecentChip}" Content="{Binding Label}" ToolTip="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
