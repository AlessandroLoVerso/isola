<UserControl x:Class="Isola.Modules.Clipboard.ClipboardCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Filter chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="GroupName" Value="clip-filter" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Isola.Brush.Surface}" CornerRadius="12" Padding="10,0" Height="24">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Foreground}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Background}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round icon button (pin / delete) -->
        <Style x:Key="RowIcon" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource Isola.Font.Icons}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Whole-row button -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="4,3,6,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scroll bar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Width="4" CornerRadius="2" Background="#38FFFFFF" HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate">
            <Button Style="{StaticResource RowButton}" Click="Row_Click" Height="36" Margin="0,0,4,1" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900">
                <Grid x:Name="Root">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon or thumbnail -->
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Isola.Brush.Surface}" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="13"
                                       Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border CornerRadius="7" Visibility="{Binding ThumbVisibility}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" Margin="9,0,8,1" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12.5" />

                    <!-- Right side: time (+ pin mark) normally, actions on hover -->
                    <StackPanel x:Name="Meta" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE718;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="10.5"
                                   Foreground="{DynamicResource Isola.Brush.Accent}" VerticalAlignment="Center" Margin="0,1,6,0"
                                   Visibility="{Binding PinVisibility}" />
                        <TextBlock Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,-2,0">
                        <Button Style="{StaticResource RowIcon}" Content="{Binding PinGlyph}" ToolTip="{Binding PinTip}" Click="Pin_Click" />
                        <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" ToolTip="Elimina" Click="Delete_Click" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Isola.Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Meta" Property="Visibility" Value="Hidden" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters + search -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" Content="Tutto" Tag="all" IsChecked="True" Checked="Chip_Checked" />
                <RadioButton Style="{StaticResource Chip}" Content="Testo" Tag="text" Checked="Chip_Checked" />
                <RadioButton Style="{StaticResource Chip}" Content="Link" Tag="link" Checked="Chip_Checked" />
                <RadioButton Style="{StaticResource Chip}" Content="Immagini" Tag="image" Checked="Chip_Checked" />
                <RadioButton Style="{StaticResource Chip}" Content="File" Tag="files" Checked="Chip_Checked" />
            </StackPanel>

            <Grid Grid.Column="1" Width="118" Height="26" VerticalAlignment="Center">
                <Border CornerRadius="13" Background="{DynamicResource Isola.Brush.Surface}" x:Name="SearchBorder" BorderThickness="1" BorderBrush="Transparent" />
                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11" Margin="10,0,0,0"
                           Foreground="{DynamicResource Isola.Brush.Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Cerca" FontSize="12" Margin="28,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Margin="25,0,22,0" VerticalAlignment="Center" FontSize="12"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Isola.Brush.Foreground}"
                         CaretBrush="{DynamicResource Isola.Brush.Foreground}" SelectionBrush="{DynamicResource Isola.Brush.Accent}"
                         FocusVisualStyle="{x:Null}" TextChanged="Search_TextChanged"
                         PreviewMouseLeftButtonDown="Search_MouseDown" GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_Focus" />
                <Button x:Name="SearchClear" Style="{StaticResource RowIcon}" Content="&#xE711;" FontSize="9" HorizontalAlignment="Right"
                        Margin="0,0,1,0" Visibility="Collapsed" Click="SearchClear_Click" ToolTip="Cancella ricerca" />
            </Grid>
        </Grid>

        <ItemsControl x:Name="List" Grid.Row="1" ItemTemplate="{StaticResource ItemTemplate}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Focusable="False">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="Scroller" CanContentScroll="True" Focusable="False"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Empty state -->
        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="EmptyGlyph" Text="&#xE77F;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="22"
                       Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center" Opacity="0.7" />
            <TextBlock x:Name="EmptyTitle" Text="Niente negli appunti" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="EmptyText" Text="Copia qualcosa: lo ritrovi qui." FontSize="12" Foreground="{DynamicResource Isola.Brush.Muted}"
                       HorizontalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- "Copiato" feedback -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                CornerRadius="13" Height="26" Padding="12,0,14,0" Background="{DynamicResource Isola.Brush.Foreground}"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastY" Y="6" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11"
                           Foreground="{DynamicResource Isola.Brush.Background}" VerticalAlignment="Center" Margin="0,1,7,0" />
                <TextBlock x:Name="ToastText" Text="Copiato" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Isola.Brush.Background}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
