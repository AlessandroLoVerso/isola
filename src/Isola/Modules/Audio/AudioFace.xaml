<Grid x:Class="Isola.Modules.Audio.AudioFace"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Resting face of the Audio module (pill ~126x34 inside its padding, peek ~290x48).
         One element per kind; the view model decides which one is visible. -->
    <Grid.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <SolidColorBrush x:Key="MuteRed" Color="#FF453A" />
        <SolidColorBrush x:Key="CallGreen" Color="#30D158" />
        <Style x:Key="FaceGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Isola.Font.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="FaceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Grid.Resources>

    <!-- Muted -->
    <Grid Visibility="{Binding IsMutedFace, Converter={StaticResource Vis}}">
        <TextBlock Text="&#xF781;" Style="{StaticResource FaceGlyph}" Foreground="{StaticResource MuteRed}" />
        <TextBlock Text="{Binding MutedFaceText}" Style="{StaticResource FaceText}" Foreground="{StaticResource MuteRed}" />
    </Grid>

    <!-- In a call -->
    <Grid Visibility="{Binding IsCallFace, Converter={StaticResource Vis}}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="&#xE720;" Style="{StaticResource FaceGlyph}" Foreground="{StaticResource CallGreen}" />
            <Ellipse Width="6" Height="6" Fill="{StaticResource CallGreen}" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding CallTime}" Style="{StaticResource FaceText}" Foreground="{StaticResource CallGreen}" />
    </Grid>

    <!-- Microphone back on (only seen in the peek after unmuting) -->
    <Grid Visibility="{Binding IsMicOnFace, Converter={StaticResource Vis}}">
        <TextBlock Text="&#xE720;" Style="{StaticResource FaceGlyph}" />
        <TextBlock Text="Microfono attivo" Style="{StaticResource FaceText}" />
    </Grid>

    <!-- Volume pop-up -->
    <Grid Visibility="{Binding IsVolumeFace, Converter={StaticResource Vis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding VolumeGlyph}" Style="{StaticResource FaceGlyph}" Width="20" />
        <Grid Grid.Column="1" Height="4" Margin="8,0,10,0" VerticalAlignment="Center">
            <Border CornerRadius="2" Background="#33FFFFFF" />
            <Border CornerRadius="2" Background="{DynamicResource Isola.Brush.Foreground}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding VolumeFraction}" />
                </Border.RenderTransform>
            </Border>
        </Grid>
        <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource FaceText}" FontSize="12"
                   MinWidth="20" TextAlignment="Right" Foreground="{DynamicResource Isola.Brush.Muted}" />
    </Grid>
</Grid>
