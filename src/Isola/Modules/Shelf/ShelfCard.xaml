<UserControl x:Class="Isola.Modules.Shelf.ShelfCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" AllowDrop="True">
    <UserControl.Resources>
        <!-- Compact pill button for the action bar -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
            <Setter Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Height="24" Padding="10,0,11,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round tile check box -->
        <Style x:Key="TileCheck" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                BorderBrush="#B3FFFFFF" Background="#99000000">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="9.5"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Isola.Brush.Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small "x" on a tile -->
        <Style x:Key="TileRemove" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="9" Background="#CC3A3A40">
                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="8"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF55555C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scroll bar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Width="4" CornerRadius="2" Background="#38FFFFFF" HorizontalAlignment="Center" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate">
            <Border x:Name="Tile" Width="78" Height="74" Margin="0,0,3,3" CornerRadius="10" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent" Cursor="Hand" ToolTip="{Binding Tooltip}"
                    ToolTipService.InitialShowDelay="900"
                    PreviewMouseLeftButtonDown="Tile_MouseDown" MouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseUp">
                <Grid>
                    <StackPanel x:Name="Body" Margin="4,4,4,0">
                        <!-- Two rows of 74 + 3 fit the 156 DIP below the action bar (no scroll bar). -->
                        <Grid Width="40" Height="40" HorizontalAlignment="Center">
                            <Image x:Name="IconImg" Source="{Binding Icon}" Width="32" Height="32"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border x:Name="ThumbBox" CornerRadius="6" Visibility="Collapsed" BorderThickness="1" BorderBrush="#22FFFFFF">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="11" TextAlignment="Center" Margin="0,3,0,0"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" LineHeight="13.5"
                                   LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                    <CheckBox x:Name="Check" Style="{StaticResource TileCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Visibility="Hidden" />
                    <Button x:Name="TileX" Style="{StaticResource TileRemove}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,4,0" Visibility="Hidden" Click="TileRemove_Click" ToolTip="Togli dalla mensola" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumb}" Value="True">
                    <Setter TargetName="ThumbBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconImg" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TileX" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Isola.Brush.Accent}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="Body" Property="Opacity" Value="0.35" />
                    <Setter TargetName="Tile" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Action bar -->
        <Grid x:Name="Bar" Margin="0,0,0,6" Height="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Summary" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Isola.Brush.Muted}"
                       TextTrimming="CharacterEllipsis" Margin="2,0,8,1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SelectAllBtn" Style="{StaticResource BarButton}" Click="SelectAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectAllGlyph" Text="&#xE762;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock x:Name="SelectAllText" Text="Seleziona tutto" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderBtn" Style="{StaticResource BarButton}" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock Text="Apri cartella" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveBtn" Style="{StaticResource BarButton}" Click="Remove_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,1,6,0" />
                        <TextBlock x:Name="RemoveText" Text="Togli" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" CanContentScroll="False">
            <ItemsControl x:Name="Tiles" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state = drop zone -->
        <Border x:Name="Empty" Grid.RowSpan="2" CornerRadius="14" Margin="0,0,0,2" Visibility="Collapsed">
            <Grid>
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="{DynamicResource Isola.Brush.Muted}" Opacity="0.45" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="24"
                               Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center" Opacity="0.8" />
                    <TextBlock Text="Trascina qui i file" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" />
                    <TextBlock Text="Restano qui finché non li trascini fuori. Non vengono copiati." FontSize="12"
                               Foreground="{DynamicResource Isola.Brush.Muted}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drop hint while files hover the card -->
        <Border x:Name="DropHint" Grid.RowSpan="2" CornerRadius="14" Margin="0,0,0,2" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#E6101014">
            <Grid>
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="5 4" Stroke="{DynamicResource Isola.Brush.Accent}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Isola.Font.Icons}" FontSize="22"
                               Foreground="{DynamicResource Isola.Brush.Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="Rilascia per mettere sulla mensola" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
