<Window x:Class="Isola.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni di Isola"
        Width="920" Height="660" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Settings.Brush.Window}"
        Foreground="{StaticResource Settings.Brush.Text}"
        FontFamily="{DynamicResource Isola.Font.Text}"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Slim scrollbar for the dark window -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" CornerRadius="3" Background="#3DFFFFFF" Margin="3,2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#66FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Settings.Brush.Sidebar}" BorderBrush="#222226" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Border Width="34" Height="16" CornerRadius="8" Background="#0B0B0D"
                            BorderBrush="#59FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource Isola.Brush.Accent}"
                                 HorizontalAlignment="Right" Margin="0,0,5,0" />
                    </Border>
                    <TextBlock Text="Isola" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,1"
                               FontFamily="{DynamicResource Isola.Font.Display}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Margin="12,8,0,0" FontSize="11"
                           Foreground="{StaticResource Settings.Brush.Muted}" />
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ContentControl x:Name="PageHost" Margin="40,30,40,32" MaxWidth="780" Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
