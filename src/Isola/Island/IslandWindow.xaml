<Window x:Class="Isola.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isola"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Isola.Font.Text}"
        FontSize="{DynamicResource Isola.FontSize.Body}"
        Foreground="{DynamicResource Isola.Brush.Foreground}">

    <Window.Resources>
        <!-- One tab per module in the open card. -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11" Padding="8,0" Height="30">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Muted}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource Isola.Font.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15" Width="30" Height="30">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource Isola.Brush.Foreground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Isola.Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window is as big as the open card; everything outside the Path is fully transparent,
         so the OS lets clicks through there (per-pixel alpha hit testing of layered windows). -->
    <Canvas x:Name="Stage">
        <Path x:Name="ShapePath" Fill="{DynamicResource Isola.Brush.Background}" />

        <!-- Clipped to the island shape every animation frame. -->
        <Canvas x:Name="ContentLayer">
            <!-- Optional inner rim set by a backdrop theme (SetIslandEdge); the clip keeps the inner half. -->
            <Path x:Name="EdgePath" IsHitTestVisible="False" />
            <Border x:Name="FaceLayer" Padding="16,0" />
            <Border x:Name="PeekLayer" Padding="20,0" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="StripLayer" Padding="14,0" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <Grid x:Name="CardLayer" Width="460" Height="250" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="12,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" CanContentScroll="False">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                    </ScrollViewer>
                    <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="6,0,0,0" />
                </Grid>

                <ContentPresenter x:Name="CardHost" Grid.Row="1" Margin="18,8,18,16" />
                <TextBlock x:Name="EmptyText" Grid.Row="1" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource Isola.Brush.Muted}"
                           Text="Nessun modulo con una scheda è attivo.&#x0a;Accendili da Impostazioni › Moduli." />
            </Grid>
        </Canvas>
    </Canvas>
</Window>
