<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Island theme resources shared with modules. Always reference them with DynamicResource:
         ThemeManager replaces the brushes when the user switches theme ("Nero" / "Grafite").
         Defaults below are "Nero". -->
    <SolidColorBrush x:Key="Isola.Brush.Background" Color="#0B0B0D" />
    <SolidColorBrush x:Key="Isola.Brush.Foreground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Isola.Brush.Muted" Color="#8E8E96" />
    <SolidColorBrush x:Key="Isola.Brush.Accent" Color="#0A84FF" />
    <SolidColorBrush x:Key="Isola.Brush.Surface" Color="#1C1C21" />
    <SolidColorBrush x:Key="Isola.Brush.SurfaceHover" Color="#26262C" />

    <FontFamily x:Key="Isola.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Isola.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Isola.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Isola.FontSize.Small">11</sys:Double>
    <sys:Double x:Key="Isola.FontSize.Body">13</sys:Double>
    <sys:Double x:Key="Isola.FontSize.Title">16</sys:Double>

    <!-- Dark tooltips everywhere (island, cards, settings, desktop widgets). Fixed colours: a tooltip
         floats over anything, so it must not turn translucent with the glass themes. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#F2F2F5" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F01C1C21" BorderBrush="#3A3A42" BorderThickness="1" CornerRadius="7"
                            Padding="9,5,9,6" Margin="0,0,0,2" SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="MaxWidth" Value="320" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
